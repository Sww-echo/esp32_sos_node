# Copy to /opt/esp32-sos/.env and replace every placeholder.
# Keep this file mode 600 and never commit the real .env.
EMQX_NODE_RED_PASSWORD=replace-with-emqx-password
NODE_RED_CREDENTIAL_SECRET=replace-with-a-long-random-secret

SOS_BARK_URL=https://api.day.app/replace-with-bark-key
SOS_NTFY_URL=
SOS_TELEGRAM_URL=
SOS_TELEGRAM_CHAT_ID=
SOS_SMS_URL=
SOS_SMS_TO=
SOS_PHONE_URL=
SOS_PHONE_TO=

# Point this at a provider adapter for future channels (DingTalk, Feishu,
# WeCom, email, custom SMS, and so on). The payload contract is documented in
# README.md. Keep authorization headers in this variable, never in the flow.
SOS_WEBHOOK_URL=
SOS_WEBHOOK_HEADERS_JSON={}

SOS_SIMULATOR_TOKEN=replace-with-a-random-token
SOS_SIMULATOR_ENABLED=false
SOS_DEDUPE_TTL_MS=86400000
SOS_OFFLINE_TIMEOUT_MS=90000
SOS_HTTP_RETRY_MAX=3
